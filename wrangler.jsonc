// Cloudflare: uygulama dosyaları statik sunulur; sadece /api/* istekleri worker/index.js'e gider
{
  "name": "airfel-bayi",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
